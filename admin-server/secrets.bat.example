@echo off
:: Copia questo file in "secrets.bat" (stessa cartella) e sostituisci il valore.
:: secrets.bat NON va mai committato su Git (e' escluso da .gitignore).
:: Stessa stringa da inserire nella pagina "Pannello Servizi" della webapp
:: (Impostazioni > Sistema > Pannello Servizi).
set ADMIN_SECRET=cambia-questa-stringa-con-una-lunga-e-casuale
