# ============================================================
# Terminale POS — Nexi PAX A35
# ============================================================

# IP statico del terminale PAX A35 sulla LAN
PAX_HOST=192.168.1.50

# Porta ECR (default PAX: 10009)
PAX_PORT=10009

# Timeout connessione TCP al terminale (ms)
PAX_CONNECT_TIMEOUT=5000

# Timeout risposta pagamento — quanto si aspetta che il cliente inserisca la carta (ms)
PAX_RESPONSE_TIMEOUT=90000

# ============================================================
# Cassa fiscale — Custom Big Plus RT
# ============================================================

# IP statico della cassa Custom sulla LAN
CUSTOM_HOST=192.168.1.51

# Porta TCP della cassa (standard Custom: 9100)
CUSTOM_PORT=9100

# Timeout per singolo comando fiscale (ms)
CUSTOM_TIMEOUT=10000

# ============================================================
# ECR Agent HTTP server
# ============================================================

# Porta HTTP dell'agente (usata dal browser/POSView)
ECR_PORT=8788
