# ============================================================
# WA Agent (porta 8789) — usato da systemd (risto-wa.service)
# ============================================================
WA_PORT=8789

# Evolution API (container Docker, vedi docker-compose.yml)
EVOLUTION_URL=http://127.0.0.1:8085
# Stessa chiave di EVOLUTION_API_KEY nel .env di docker-compose (stesso file va bene)
EVOLUTION_API_KEY=cambiami-chiave-lunga-casuale
EVOLUTION_INSTANCE=risto

# Token che i tablet inseriscono la prima volta in /whatsapp (salvato per dispositivo)
# Genera con: openssl rand -hex 24
WA_ACCESS_TOKEN=cambiami-token-tablet

# Segreto nel percorso del webhook che Evolution chiama per i messaggi in tempo reale
# Genera con: openssl rand -hex 24
WA_WEBHOOK_SECRET=cambiami-segreto-webhook
# Default: http://host.docker.internal:8789/webhook/<WA_WEBHOOK_SECRET>
# WA_WEBHOOK_URL=

# ============================================================
# Solo per docker-compose (Evolution + Postgres dedicato)
# ============================================================
EVOLUTION_DB_PASSWORD=cambiami-password-db
